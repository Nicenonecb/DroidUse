+    private boolean isSystemPickerPackage(String packageName) {
+        Intent documents = new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                .addCategory(Intent.CATEGORY_OPENABLE).setType("*/*");
+        Intent photos = new Intent(android.provider.MediaStore.ACTION_PICK_IMAGES)
+                .setType("image/*");
+        for (Intent intent : java.util.List.of(documents, photos)) {
+            android.content.pm.ResolveInfo resolved = mPackageManager.resolveActivity(
+                    intent, android.content.pm.PackageManager.MATCH_SYSTEM_ONLY);
+            if (resolved != null && resolved.activityInfo != null
+                    && packageName.equals(resolved.activityInfo.packageName)
+                    && resolved.activityInfo.applicationInfo.uid >= 10000
+                    && (resolved.activityInfo.applicationInfo.flags
+                            & android.content.pm.ApplicationInfo.FLAG_SYSTEM) != 0) return true;
+        }
+        return false;
+    }
