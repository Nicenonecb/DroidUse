java_library {
    name: "droiduse-system-api",
    srcs: [
        "src/main/aidl/**/*.aidl",
        "src/main/java/**/*.java",
    ],
    aidl: {
        local_include_dirs: ["src/main/aidl"],
        export_aidl_headers: true,
    },
    sdk_version: "system_current",
    min_sdk_version: "35",
    installable: false,
}
